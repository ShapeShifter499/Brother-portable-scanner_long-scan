# Maintainer: ShapeShifter499
pkgname=brscan5-longpaper-git
_repo=Brother-portable-scanner_long-scan
pkgver=r22.16eb60e
pkgrel=1
pkgdesc="SANE backend for single-sided long paper scanning on Brother DS-740D and ADS-1200"
arch=('x86_64')
url="https://github.com/ShapeShifter499/${_repo}"
license=('GPL-2.0-only')
depends=('bash' 'brscan5' 'glibc' 'libusb' 'sane')
makedepends=('git')
optdepends=('imagemagick: save scan-long output as PNG, JPEG or PDF')
provides=("${pkgname%-git}")
conflicts=("${pkgname%-git}")
backup=('etc/sane.d/dll.d/brother5lp')
source=("git+${url}.git")
sha256sums=('SKIP')

pkgver() {
    cd "$_repo"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd "$_repo"
    make
}

package() {
    cd "$_repo"
    make DESTDIR="$pkgdir" PREFIX=/usr install
}
